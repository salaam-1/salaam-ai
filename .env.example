# ---------------------------------------------------------------------------
# Salaam — example configuration
#
# Copy this file to .env and fill in only the values you need.
# NEVER commit .env or real API keys to GitHub.
# ---------------------------------------------------------------------------

# --- Personal defaults -----------------------------------------------------
OWNER_NAME=YourName
HOME_CITY=YourCity
HOME_COUNTRY=YourCountry
TIMEZONE=Your/Timezone

# Persistent memory, notes and reminders.
# Defaults to ~/.salaam when left blank.
SALAAM_DATA_DIR=

# --- Web search (optional) -------------------------------------------------
BRAVE_API_KEY=

# --- MCP server ------------------------------------------------------------
SERVER_NAME=Salaam
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=sse
DEBUG=false
SALAAM_MCP_URL=

# --- Voice / LiveKit -------------------------------------------------------
# Required only when using the browser voice experience.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice pipeline --------------------------------------------------------
# Leave blank for the application's automatic selection.
SALAAM_PIPELINE=

# Optional provider credentials.
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# --- Musa business assistant (optional) -----------------------------------
SUPABASE_URL=
SUPABASE_API_KEY=
